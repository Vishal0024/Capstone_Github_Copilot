  "main": "index.js",
  "scripts": {
    "start": "npx nodemon todoServer.js",
    "test": "node --test",
    "test:unit": "node --test tests/*.test.js",
    "test:integration": "node --test tests/*.integration.test.js",
    "lint": "node --check todoServer.js && node --check public/script.js && node --check .github/hooks/git-safety-guard.cjs",
