{
  "servers": {
    "jira-mcp": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "mcp-atlassian"
      ],
      "env": {
        "JIRA_URL": "https://jiraeu.epam.com",
        "JIRA_PERSONAL_TOKEN": "${env:JIRA_PERSONAL_TOKEN}",
        "JIRA_SSL_VERIFY": "false"
      }
    }
  }
}
